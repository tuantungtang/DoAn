      <RuleRegularExpression Id="DevExpress.Persistent.Validation.RuleRegularExpression_DoAn.Module.BusinessObjects.Authentication.ApplicationUser_PhoneNumber" Pattern="(84|0[3|5|7|8|9])+([0-9]{8})\b" TargetType="DoAn.Module.BusinessObjects.Authentication.ApplicationUser" TargetPropertyName="PhoneNumber" TargetContextIDs="Save" CustomMessageTemplate="'Phone Number' is incorrect format of Viet Nam" IsNewNode="True" />
      <RuleRegularExpression Id="DevExpress.Persistent.Validation.RuleRegularExpression_DoAn.Module.BusinessObjects.Class.Category" TargetPropertyName="CategoryName" TargetType="DoAn.Module.BusinessObjects.Class.Category" Pattern="^(?!\s*$).+" TargetContextIDs="Save" CustomMessageTemplate="'Category Name' cannot be empty!" IsNewNode="True" />
