      <RuleRegularExpression Id="DevExpress.Persistent.Validation.RuleRegularExpression_DoAn.Module.BusinessObjects.Authentication.ApplicationUser_Email" TargetContextIDs="Save" TargetPropertyName="Email" TargetType="DoAn.Module.BusinessObjects.Authentication.ApplicationUser" Pattern="^(?=.{5,255}$)([a-zA-Z0-9]+([._+-]?[a-zA-Z0-9]+)*)@([a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*\.[a-zA-Z]{2,})$" CustomMessageTemplate="'Email&quot; is incorrect format" IsNewNode="True" />
